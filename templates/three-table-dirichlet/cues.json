[
  {"t0": 0.00, "t1": 10.35, "text": "В любом городе-миллионнике есть двое с одним числом волос."},
  {"t0": 10.40, "t1": 16.15, "text": "3 человека. 2 числа. Ноль и один."},
  {"t0": 16.20, "t1": 19.15, "text": "Третий падает в занятый ящик."},
  {"t0": 19.18, "t1": 26.05, "text": "Людей больше, чем чисел. У двоих число одно."},
  {"t0": 26.40, "t1": 38.05, "text": "От нуля до 500 000. 500 001 вариант."},
  {"t0": 38.08, "t1": 46.28, "text": "1 000 000 человек. 500 001 ящик. Ящики кончились."},
  {"t0": 46.32, "t1": 52.20, "text": "Кто они — неизвестно. Что они есть — доказано."}
]
