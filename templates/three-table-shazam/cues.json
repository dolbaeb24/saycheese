[
  {"t0": 0.00, "t1": 3.80, "text": "Shazam узнаёт песню за пару секунд."},
  {"t0": 3.85, "t1": 6.65, "text": "Он ищет звёзды."},
  {"t0": 6.85, "t1": 15.25, "text": "Время × частота. Звук — это карта."},
  {"t0": 15.45, "t1": 22.60, "text": "Шум — мелкий. Пики — громкие."},
  {"t0": 22.80, "t1": 27.75, "text": "Остались только звёзды."},
  {"t0": 27.95, "t1": 36.30, "text": "Пара звёзд — ключ."},
  {"t0": 36.50, "t1": 42.70, "text": "Сотни ключей. Миллионы песен."},
  {"t0": 42.70, "t1": 46.10, "text": "Совпадений много."},
  {"t0": 46.30, "t1": 52.40, "text": "Шум — вразброс. Песня — в линию."},
  {"t0": 52.60, "t1": 61.00, "text": "Найдена по звёздам. (По статье Эвери Вана, 2003)"}
]
